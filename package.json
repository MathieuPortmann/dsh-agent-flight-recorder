{
  "name": "dsh-agent-flight-recorder",
  "version": "0.1.1",
  "description": "Live runtime health for DeepSeek Harness agents: loop detection, runtime_health tool, Runtime Health panel and a per-turn health summary for the user and the model.",
  "type": "module",
  "license": "MIT",
  "author": "Mathieu Portmann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MathieuPortmann/dsh-agent-flight-recorder.git"
  },
  "homepage": "https://github.com/MathieuPortmann/dsh-agent-flight-recorder#readme",
  "bugs": {
    "url": "https://github.com/MathieuPortmann/dsh-agent-flight-recorder/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "observability",
    "loop-detection"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0",
    "zod": ">=4.0.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "manifestVersion": 1
  }
}
